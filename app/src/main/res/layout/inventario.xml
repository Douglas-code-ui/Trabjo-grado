<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kemba_black"
    android:orientation="vertical"
    android:padding="20dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Inventario"
            android:textColor="@color/kemba_gold"
            android:textSize="28sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnConfig"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:contentDescription="Configuración"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings"
            app:tint="@color/kemba_gold" />
    </RelativeLayout>

    <!-- Tabla con scroll: ocupa el espacio disponible y el botón queda abajo -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:scrollbars="none">

        <TableLayout
            android:id="@+id/tableInventario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*">

            <TableRow android:background="@color/kemba_surface">

                <TextView
                    android:padding="12dp"
                    android:text="ID"
                    android:textColor="@color/kemba_gold"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:padding="12dp"
                    android:text="Producto"
                    android:textColor="@color/kemba_gold"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:padding="12dp"
                    android:text="Stock"
                    android:textColor="@color/kemba_gold"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:padding="12dp"
                    android:text="Precio"
                    android:textColor="@color/kemba_gold"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </TableRow>
        </TableLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCrear"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="Registrar Prenda"
        android:textColor="@color/kemba_black"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/kemba_gold"
        app:cornerRadius="26dp" />
</LinearLayout>