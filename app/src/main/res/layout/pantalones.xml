<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kemba_black"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- TÍTULO -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Pantalones"
                android:textColor="@color/kemba_gold"
                android:textSize="28sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Campana -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/imgNotificacion"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:contentDescription="Notificaciones"
                        android:padding="2dp"
                        android:src="@drawable/ic_bell"
                        app:tint="@color/kemba_white" />

                    <TextView
                        android:id="@+id/txtContador"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="end|top"
                        android:background="@drawable/bg_badge_red"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:visibility="gone" />
                </FrameLayout>

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="16dp"
                    android:contentDescription="Configuración"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/kemba_gold" />
            </LinearLayout>
        </RelativeLayout>

        <!-- BUSCADOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:id="@+id/btnBuscar"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Buscar"
                android:src="@drawable/ic_search"
                app:tint="@color/kemba_hint" />

            <EditText
                android:id="@+id/txtBuscar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Buscar"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="12dp"
                android:textColor="@color/kemba_white"
                android:textColorHint="@color/kemba_hint"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- CARRUSEL 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/bg_card"
            android:gravity="center">

            <ImageView
                android:id="@+id/btnPrev1"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Anterior"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/kemba_gold" />

            <ImageView
                android:id="@+id/imgCarrusel1"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:contentDescription="@null"
                android:scaleType="centerInside"
                android:src="@drawable/pan1" />

            <ImageView
                android:id="@+id/btnNext1"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Siguiente"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/kemba_gold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtNombre1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Nombre pantalon"
            android:textColor="@color/kemba_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPrecio1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="$0"
            android:textColor="@color/kemba_gold"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtStock1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="24dp"
            android:text="Stock: 0"
            android:textColor="@color/kemba_hint"
            android:textSize="14sp" />

        <!-- CARRUSEL 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/bg_card"
            android:gravity="center">

            <ImageView
                android:id="@+id/btnPrev2"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Anterior"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/kemba_gold" />

            <ImageView
                android:id="@+id/imgCarrusel2"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:contentDescription="@null"
                android:scaleType="centerInside"
                android:src="@drawable/pan2" />

            <ImageView
                android:id="@+id/btnNext2"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Siguiente"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/kemba_gold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtNombre2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Nombre pantalon"
            android:textColor="@color/kemba_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPrecio2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="$0"
            android:textColor="@color/kemba_gold"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtStock2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="24dp"
            android:text="Stock: 0"
            android:textColor="@color/kemba_hint"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="40dp" />
    </LinearLayout>
</ScrollView>