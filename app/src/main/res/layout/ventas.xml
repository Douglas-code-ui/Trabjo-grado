<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kemba_black">

    <!-- Título -->
    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:text="Ventas"
        android:textColor="@color/kemba_gold"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tabla (el padding inferior deja espacio para que el botón + no tape la última fila) -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_card"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo">

        <TableLayout
            android:id="@+id/tableVentas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*">

            <!-- ENCABEZADOS -->
            <TableRow android:background="@color/kemba_surface">

                <TextView
                    android:padding="12dp"
                    android:text="Empleado"
                    android:textColor="@color/kemba_gold"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:padding="12dp"
                    android:text="Prendas"
                    android:textColor="@color/kemba_gold"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:padding="12dp"
                    android:text="Fecha"
                    android:textColor="@color/kemba_gold"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:padding="12dp"
                    android:text="Total"
                    android:textColor="@color/kemba_gold"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </TableRow>
        </TableLayout>
    </ScrollView>

    <!-- Botón flotante tipo + -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnAgregar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:contentDescription="Agregar"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/kemba_gold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/kemba_black" />
</androidx.constraintlayout.widget.ConstraintLayout>