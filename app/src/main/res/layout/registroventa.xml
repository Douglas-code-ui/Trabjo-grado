<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kemba_black"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".RegistroVenta">

    <LinearLayout
        android:id="@+id/linearRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- TITULO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Registro de ventas"
            android:textColor="@color/kemba_gold"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- USUARIO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_user"
                app:tint="@color/kemba_gold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtNombreEmpleado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/kemba_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtRolEmpleado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Empleado"
                    android:textColor="@color/kemba_gold"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- PRENDA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Prenda"
            android:textColor="@color/kemba_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerPrenda"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_input"
            android:paddingStart="6dp"
            android:popupBackground="@color/kemba_surface" />

        <!-- CANTIDAD -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Cantidad"
            android:textColor="@color/kemba_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCantidad"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_input"
            android:hint="0"
            android:importantForAutofill="no"
            android:inputType="number"
            android:padding="14dp"
            android:textColor="@color/kemba_white"
            android:textColorHint="@color/kemba_hint"
            android:textSize="14sp" />

        <!-- TOTAL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Total a pagar"
            android:textColor="@color/kemba_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTotal"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_input"
            android:enabled="false"
            android:importantForAutofill="no"
            android:padding="14dp"
            android:text="0"
            android:textColor="@color/kemba_gold"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- TIPO DE PAGO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Tipo de pago"
            android:textColor="@color/kemba_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgPago"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:orientation="vertical">

            <RadioButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_role"
                android:buttonTint="@color/kemba_gold"
                android:padding="10dp"
                android:text="Efectivo"
                android:textColor="@color/kemba_white" />

            <RadioButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_role"
                android:buttonTint="@color/kemba_gold"
                android:padding="10dp"
                android:text="Tarjeta"
                android:textColor="@color/kemba_white" />

            <RadioButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_role"
                android:buttonTint="@color/kemba_gold"
                android:padding="10dp"
                android:text="Transferencia"
                android:textColor="@color/kemba_white" />
        </RadioGroup>

        <!-- BOTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegistrar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Registrar venta"
            android:textColor="@color/kemba_black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/kemba_gold"
            app:cornerRadius="26dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />
    </LinearLayout>
</ScrollView>