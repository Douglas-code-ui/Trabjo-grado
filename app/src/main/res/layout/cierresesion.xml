<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kemba_black"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- MENSAJE -->
    <TextView
        android:id="@+id/txtSesionCerrada"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:gravity="center"
        android:text="Sesión cerrada con éxito"
        android:textColor="@color/kemba_gold"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- LOGO -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_marginBottom="40dp"
        android:contentDescription="Logo de Kemba Store"
        android:src="@drawable/logo_kemba" />

    <!-- BOTÓN -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVolver"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Volver al inicio"
        android:textColor="@color/kemba_black"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/kemba_gold"
        app:cornerRadius="26dp" />

</LinearLayout>